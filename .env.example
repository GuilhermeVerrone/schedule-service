# Postgres no Neon (projeto "slotz"). Copie para .env e preencha.
# Branch dev: pooled (app) e direta (migrações)
DATABASE_URL=
DIRECT_URL=

# Branch test: usada pelo Vitest
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# Domínio (nunca fixo no código)
APP_BASE_URL=
PUBLIC_BOOKING_BASE_URL=
EMAIL_FROM_DOMAIN=

# WhatsApp (adapter em src/server/whatsapp/). Provider: "akg" ou "fake" (obrigatório em produção;
# sem valor, o Fake é usado fora de produção). O E2E roda com "fake".
WHATSAPP_PROVIDER=
# WA-AKG (WhatsApp não oficial): URL da instância e chave da API, só no servidor
AKG_BASE_URL=
AKG_API_KEY=
# Segredo que o provedor envia ao chamar /api/webhooks/whatsapp
WHATSAPP_WEBHOOK_SECRET=
