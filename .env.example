# Postgres no Neon (projeto "slotz"). Copie para .env e preencha.
# Branch dev: pooled (app) e direta (migrações)
DATABASE_URL=
DIRECT_URL=

# Branch test: usada pelo Vitest
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# Domínio (nunca fixo no código)
APP_BASE_URL=
PUBLIC_BOOKING_BASE_URL=
# Subdomínio de envio dos e-mails (SPF/DKIM/DMARC no deploy); o remetente é nao-responda@<domínio>
EMAIL_FROM_DOMAIN=

# WhatsApp (adapter em src/server/whatsapp/). Provider: "akg" ou "fake" (obrigatório em produção;
# sem valor, o Fake é usado fora de produção). O E2E roda com "fake".
WHATSAPP_PROVIDER=
# WA-AKG (WhatsApp não oficial): URL da instância e chave da API, só no servidor
AKG_BASE_URL=
AKG_API_KEY=
# Segredo que o provedor envia ao chamar /api/webhooks/whatsapp
WHATSAPP_WEBHOOK_SECRET=

# Redis das filas BullMQ (D1). No Compose o app e o worker usam o serviço "redis" da rede interna
# (sem porta pública) e a URL é montada a partir de REDIS_PASSWORD; fora do Compose, a URL inteira.
REDIS_PASSWORD=
REDIS_URL=
# Redis local só para os testes de integração (docker-compose.test.yml, preso em 127.0.0.1)
TEST_REDIS_PASSWORD=
TEST_REDIS_URL=

# E-mail de reserva quando o WhatsApp cai (adapter em src/server/email/). Provider: "resend" ou
# "fake" (obrigatório em produção; sem valor, o Fake é usado fora de produção).
EMAIL_PROVIDER=
# Chave da API do Resend, só no servidor
RESEND_API_KEY=
